#!/usr/bin/env python3

import argparse
import base64
import configparser
import datetime
import json
import os
import re
import socket
import socketserver
import threading
import time
import uuid
from pathlib import Path

import serial


NAME_RE = re.compile(r"^[a-z0-9_-]+$")

REPO_DIR = Path(__file__).resolve().parent.parent
DEFAULT_CONFIG_DIR = REPO_DIR / "config"
DEFAULT_LOG_ROOT = REPO_DIR / "logs"

BYTESIZE_MAP = {
    5: serial.FIVEBITS,
    6: serial.SIXBITS,
    7: serial.SEVENBITS,
    8: serial.EIGHTBITS,
}
PARITY_MAP = {
    "none": serial.PARITY_NONE,
    "even": serial.PARITY_EVEN,
    "odd": serial.PARITY_ODD,
    "mark": serial.PARITY_MARK,
    "space": serial.PARITY_SPACE,
}
STOPBITS_MAP = {
    "1": serial.STOPBITS_ONE,
    "1.5": serial.STOPBITS_ONE_POINT_FIVE,
    "2": serial.STOPBITS_TWO,
}
FLOW_MAP = ("none", "rtscts", "xonxoff")


def runtime_dir():
    return Path(
        os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    )


def instance_socket(name):
    return runtime_dir() / f"seriald-{name}.sock"


def load_instance(name, config_dir):
    if not NAME_RE.match(name):
        raise SystemExit(
            f"实例名不合法: {name!r}（只允许小写字母、数字、下划线、短横线）"
        )

    path = Path(config_dir) / f"{name}.conf"
    if not path.is_file():
        raise SystemExit(f"配置不存在: {path}")

    cp = configparser.ConfigParser(inline_comment_prefixes=("#", ";"))
    cp.read(path, encoding="utf-8")

    def get(section, key, default=None):
        if not cp.has_section(section):
            return default
        return cp.get(section, key, fallback=default)

    device = (get("serial", "device") or "").strip()
    if not device:
        raise SystemExit(f"{path}: [serial] device 未配置")

    try:
        baud = int((get("serial", "baud") or "115200").strip())
        databits = int((get("serial", "databits") or "8").strip())
        wait_log_interval = float(
            (get("log", "wait_log_interval") or "600").strip()
        )
        retention_days = int(
            (get("log", "retention_days") or "0").strip()
        )
    except ValueError as e:
        raise SystemExit(f"{path}: 数值字段无效: {e}")

    parity = (get("serial", "parity") or "none").strip().lower()
    stopbits = (get("serial", "stopbits") or "1").strip()
    flow = (get("serial", "flow") or "none").strip().lower()

    if databits not in BYTESIZE_MAP:
        raise SystemExit(f"{path}: databits 必须是 5/6/7/8")
    if parity not in PARITY_MAP:
        raise SystemExit(f"{path}: parity 必须是 {'/'.join(PARITY_MAP)}")
    if stopbits not in STOPBITS_MAP:
        raise SystemExit(f"{path}: stopbits 必须是 1/1.5/2")
    if flow not in FLOW_MAP:
        raise SystemExit(f"{path}: flow 必须是 {'/'.join(FLOW_MAP)}")
    if wait_log_interval < 1:
        wait_log_interval = 1
    if retention_days < 0:
        retention_days = 0

    log_dir = (get("log", "dir") or "").strip()
    if log_dir:
        log_dir = Path(log_dir).expanduser()
    else:
        log_dir = DEFAULT_LOG_ROOT / name

    return {
        "name": name,
        "config_path": path,
        "device": os.path.expanduser(device),
        "baud": baud,
        "databits": databits,
        "parity": parity,
        "stopbits": stopbits,
        "flow": flow,
        "log_dir": log_dir,
        "wait_log_interval": wait_log_interval,
        "retention_days": retention_days,
    }


class DailyLogger:
    # .log 是人读的：写入前去掉 ANSI/控制符；.jsonl 保持原始字节（转义完整）。
    CSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
    OSC_RE = re.compile(r"\x1b\][^\x07]*(?:\x07|\x1b\\)")
    CHARSET_RE = re.compile(r"\x1b[()][A-Za-z0-9]")
    ESC_OTHER_RE = re.compile(r"\x1b[@-Z\\-_]")

    @classmethod
    def clean_for_log(cls, text):
        text = cls.OSC_RE.sub("", text)
        text = cls.CSI_RE.sub("", text)
        text = cls.CHARSET_RE.sub("", text)
        text = cls.ESC_OTHER_RE.sub("", text)
        text = text.replace("\x07", "")
        # \r 按行处理：同一行内只保留最后一段（模拟终端覆盖）
        lines = []
        for line in text.split("\n"):
            line = line.rstrip("\r")
            if "\r" in line:
                line = line.split("\r")[-1]
            lines.append(line)
        return "\n".join(lines)

    def __init__(self, directory, retention_days=0):
        self.dir = Path(directory).expanduser()
        self.dir.mkdir(parents=True, exist_ok=True)
        self.lock = threading.Lock()
        self.day = None
        self.logf = None
        self.jsonf = None
        self.retention_days = retention_days
        self._cleanup()

    def _cleanup(self):
        if self.retention_days <= 0:
            return

        cutoff = time.time() - self.retention_days * 86400

        for pattern in ("*.log", "*.jsonl"):
            for path in self.dir.glob(pattern):
                if path.name.startswith("latest."):
                    continue
                try:
                    if path.stat().st_mtime < cutoff:
                        path.unlink()
                except OSError:
                    pass

    def _open(self):
        day = datetime.datetime.now().astimezone().strftime("%Y-%m-%d")
        if day == self.day and self.logf and self.jsonf:
            return

        if self.logf:
            self.logf.close()
        if self.jsonf:
            self.jsonf.close()

        self.day = day
        log_path = self.dir / f"{day}.log"
        json_path = self.dir / f"{day}.jsonl"

        self.logf = open(log_path, "a", encoding="utf-8", buffering=1)
        self.jsonf = open(json_path, "a", encoding="utf-8", buffering=1)

        latest = self.dir / "latest.log"
        try:
            latest.unlink()
        except FileNotFoundError:
            pass
        latest.symlink_to(log_path.name)

    def write(self, kind, data="", actor=None, event=None):
        with self.lock:
            self._open()

            now = datetime.datetime.now().astimezone()
            human_ts = now.strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
            iso_ts = now.isoformat(timespec="milliseconds")

            if kind == "rx":
                tag = "RX"
            elif kind == "tx":
                tag = f"TX:{actor or 'unknown'}"
            else:
                tag = "EVENT"

            if event:
                text = event
                if data:
                    text += f" {data}"
            else:
                text = data

            # human-readable log（清洗 ANSI/控制符；jsonl 保留原始数据）
            parts = self.clean_for_log(text).split("\n")
            if not parts:
                parts = [""]

            for part in parts:
                if part == "" and len(parts) > 1:
                    continue
                self.logf.write(f"[{human_ts}] [{tag}] {part}\n")

            # machine-readable log
            obj = {
                "ts": iso_ts,
                "type": kind,
            }

            if actor:
                obj["actor"] = actor
            if event:
                obj["event"] = event
            if data:
                obj["data"] = data

            self.jsonf.write(
                json.dumps(obj, ensure_ascii=False) + "\n"
            )


class SerialState:
    MAX_HISTORY = 2 * 1024 * 1024

    def __init__(self, instance, logger):
        self.instance = instance
        self.device = instance["device"]
        self.baud = instance["baud"]
        self.logger = logger
        self.wait_log_interval = instance["wait_log_interval"]

        self.ser = None
        self.connected = False
        self.resolved_device = None

        self.serial_lock = threading.Lock()
        self.history_lock = threading.Condition()
        self.history = bytearray()
        self.base_seq = 0
        self.end_seq = 0

    def current_seq(self):
        with self.history_lock:
            return self.end_seq

    def append_rx(self, data):
        with self.history_lock:
            self.history.extend(data)
            self.end_seq += len(data)

            if len(self.history) > self.MAX_HISTORY:
                remove = len(self.history) - self.MAX_HISTORY
                del self.history[:remove]
                self.base_seq += remove

            self.history_lock.notify_all()

    def text_since(self, seq):
        with self.history_lock:
            if seq < self.base_seq:
                seq = self.base_seq

            offset = seq - self.base_seq
            return bytes(self.history[offset:]).decode(
                "utf-8",
                errors="replace",
            )

    def snapshot_since(self, seq):
        with self.history_lock:
            if seq < self.base_seq:
                seq = self.base_seq

            offset = seq - self.base_seq
            return bytes(self.history[offset:]), self.end_seq

    def wait_for(self, pattern, start_seq, timeout, regex=False):
        deadline = time.monotonic() + timeout

        with self.history_lock:
            while True:
                if start_seq < self.base_seq:
                    start_seq = self.base_seq

                offset = start_seq - self.base_seq
                text = bytes(self.history[offset:]).decode(
                    "utf-8",
                    errors="replace",
                )

                if regex:
                    match = re.search(pattern, text, re.MULTILINE)
                    if match:
                        return True, text
                else:
                    if pattern in text:
                        return True, text

                left = deadline - time.monotonic()
                if left <= 0:
                    return False, text

                self.history_lock.wait(timeout=min(left, 0.5))

    def send_bytes(self, data, actor="unknown"):
        with self.serial_lock:
            if not self.ser or not self.connected:
                raise RuntimeError("serial device is not connected")

            self.ser.write(data)
            self.ser.flush()

        self.logger.write(
            "tx",
            data.decode("utf-8", errors="replace"),
            actor=actor,
        )

    def send(self, text, actor="unknown"):
        self.send_bytes(text.encode("utf-8"), actor)

    def status(self):
        return {
            "instance": self.instance["name"],
            "config": str(self.instance["config_path"]),
            "connected": self.connected,
            "device": self.device,
            "resolved_device": self.resolved_device,
            "baud": self.baud,
            "log_dir": str(self.instance["log_dir"]),
            "rx_seq": self.current_seq(),
        }


STATE = None


def open_serial(instance):
    return serial.Serial(
        port=instance["device"],
        baudrate=instance["baud"],
        bytesize=BYTESIZE_MAP[instance["databits"]],
        parity=PARITY_MAP[instance["parity"]],
        stopbits=STOPBITS_MAP[instance["stopbits"]],
        rtscts=(instance["flow"] == "rtscts"),
        xonxoff=(instance["flow"] == "xonxoff"),
        timeout=0.2,
        write_timeout=2,
    )


def serial_worker():
    global STATE

    last_wait_log = 0

    while True:
        if STATE.ser is None:
            try:
                resolved = os.path.realpath(STATE.device)

                ser = open_serial(STATE.instance)

                STATE.ser = ser
                STATE.connected = True
                STATE.resolved_device = resolved

                STATE.logger.write(
                    "event",
                    data=f"{STATE.device} -> {resolved} baud={STATE.baud}",
                    event="CONNECT",
                )

            except Exception as e:
                now = time.monotonic()
                if now - last_wait_log > STATE.wait_log_interval:
                    STATE.logger.write(
                        "event",
                        data=str(e),
                        event="WAITING_DEVICE",
                    )
                    last_wait_log = now

                time.sleep(1)
                continue

        try:
            data = STATE.ser.read(4096)

            if data:
                STATE.append_rx(data)
                STATE.logger.write(
                    "rx",
                    data.decode("utf-8", errors="replace"),
                )

        except Exception as e:
            STATE.logger.write(
                "event",
                data=str(e),
                event="DISCONNECT",
            )

            with STATE.serial_lock:
                try:
                    if STATE.ser:
                        STATE.ser.close()
                except Exception:
                    pass

                STATE.ser = None
                STATE.connected = False
                STATE.resolved_device = None

            time.sleep(1)


class Handler(socketserver.StreamRequestHandler):
    def send_response(self, obj):
        self.wfile.write(
            (json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8")
        )
        self.wfile.flush()

    def read_request_line(self):
        data = b""
        while b"\n" not in data:
            chunk = self.connection.recv(65536)
            if not chunk:
                return b"", b""
            data += chunk

        return data.split(b"\n", 1)

    def handle_attach(self, req, recv_buffer=b""):
        actor = req.get("actor", "human")
        seq = STATE.current_seq()

        self.send_response({
            "ok": True,
            "mode": "attach",
            "escape": "ctrl-]",
        })

        self.connection.settimeout(0.05)

        while True:
            text, new_seq = STATE.snapshot_since(seq)
            if text:
                try:
                    self.send_response({
                        "type": "rx",
                        "data_b64": base64.b64encode(text).decode("ascii"),
                    })
                except (socket.timeout, ConnectionResetError,
                        BrokenPipeError, OSError):
                    return
                seq = new_seq

            try:
                chunk = self.connection.recv(65536)
                if not chunk:
                    return
                recv_buffer += chunk
            except socket.timeout:
                chunk = None
            except (ConnectionResetError, BrokenPipeError, OSError):
                return

            while b"\n" in recv_buffer:
                line, recv_buffer = recv_buffer.split(b"\n", 1)
                if not line:
                    continue

                try:
                    msg = json.loads(line.decode("utf-8"))
                    if msg.get("type") != "tx":
                        continue

                    data = base64.b64decode(
                        msg.get("data_b64", ""),
                        validate=True,
                    )
                    if data:
                        STATE.send_bytes(data, actor)
                except Exception as e:
                    try:
                        self.send_response({
                            "type": "error",
                            "error": str(e),
                        })
                    except (socket.timeout, ConnectionResetError,
                            BrokenPipeError, OSError):
                        return

    def handle(self):
        try:
            line, recv_buffer = self.read_request_line()
        except OSError:
            return

        if not line:
            return

        try:
            req = json.loads(line.decode("utf-8"))
            cmd = req.get("cmd")

            if cmd == "status":
                self.send_response({
                    "ok": True,
                    **STATE.status(),
                })
                return

            if cmd == "attach":
                self.handle_attach(req, recv_buffer)
                return

            if cmd == "send":
                text = req.get("text", "")
                actor = req.get("actor", "unknown")
                STATE.send(text, actor)
                self.send_response({"ok": True})
                return

            if cmd == "wait":
                pattern = req["pattern"]
                timeout = float(req.get("timeout", 30))
                regex = bool(req.get("regex", False))

                start_seq = req.get("start_seq")
                if start_seq is None:
                    start_seq = STATE.current_seq()

                ok, text = STATE.wait_for(
                    pattern,
                    int(start_seq),
                    timeout,
                    regex,
                )

                self.send_response({
                    "ok": ok,
                    "matched": ok,
                    "data": text,
                })
                return

            if cmd == "exec":
                command = req["command"]
                actor = req.get("actor", "unknown")
                timeout = float(req.get("timeout", 30))

                token = uuid.uuid4().hex
                marker = f"__SC_{token}__"

                start_seq = STATE.current_seq()

                # marker is deliberately assembled by printf, so terminal echo
                # does not contain the complete marker and cause a false hit.
                payload = (
                    f"{command}\n"
                    f"__sc_rc=$?\n"
                    f"printf '\\n__SC_%s__:%s\\n' '{token}' \"$__sc_rc\"\n"
                )

                STATE.send(payload, actor)

                ok, text = STATE.wait_for(
                    marker + ":",
                    start_seq,
                    timeout,
                    False,
                )

                if not ok:
                    self.send_response({
                        "ok": False,
                        "error": "timeout waiting for command marker",
                        "data": text,
                    })
                    return

                m = re.search(
                    re.escape(marker) + r":(-?\d+)",
                    text,
                )

                rc = int(m.group(1)) if m else None

                output = text
                if m:
                    output = text[:m.start()]

                self.send_response({
                    "ok": True,
                    "rc": rc,
                    "data": output,
                })
                return

            self.send_response({
                "ok": False,
                "error": f"unknown command: {cmd}",
            })

        except Exception as e:
            self.send_response({
                "ok": False,
                "error": str(e),
            })


class ThreadingUnixServer(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True


def main():
    global STATE

    ap = argparse.ArgumentParser(
        prog="seriald",
        description="串口实例 broker（配置驱动）",
    )
    ap.add_argument(
        "-s",
        "--serial",
        required=True,
        help="实例名，对应 config/<名字>.conf",
    )
    ap.add_argument(
        "--config-dir",
        default=str(DEFAULT_CONFIG_DIR),
        help="配置目录（默认 <repo>/config）",
    )
    args = ap.parse_args()

    instance = load_instance(args.serial, args.config_dir)

    logger = DailyLogger(
        instance["log_dir"],
        instance["retention_days"],
    )
    STATE = SerialState(instance, logger)

    socket_path = instance_socket(instance["name"])
    os.makedirs(os.path.dirname(socket_path), exist_ok=True)

    try:
        os.unlink(socket_path)
    except FileNotFoundError:
        pass

    logger.write(
        "event",
        data=(
            f"instance={instance['name']} device={instance['device']} "
            f"baud={instance['baud']} databits={instance['databits']} "
            f"parity={instance['parity']} stopbits={instance['stopbits']} "
            f"flow={instance['flow']} log_dir={instance['log_dir']}"
        ),
        event="SERIALD_START",
    )

    threading.Thread(
        target=serial_worker,
        daemon=True,
    ).start()

    with ThreadingUnixServer(str(socket_path), Handler) as server:
        os.chmod(socket_path, 0o600)

        try:
            server.serve_forever()
        finally:
            try:
                os.unlink(socket_path)
            except FileNotFoundError:
                pass


if __name__ == "__main__":
    main()
